<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Monitoring_pkl.MainPage"
             Title="Login">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
                <Label Text="Please sign in" FontSize="24" HorizontalOptions="Center" />

                <Entry x:Name="UsernameEntry" Placeholder="Username" />
                <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

                <Button x:Name="LoginButton" Text="Login" Clicked="OnLoginClicked" HorizontalOptions="Fill" />

                <Label x:Name="MessageLabel" TextColor="Red" IsVisible="False" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>
